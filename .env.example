APP_NAME="Ruma Organic"
APP_ENV=production
APP_KEY=
APP_DEBUG=true
APP_URL=http://32.236.186.96

WEB_PORT=80

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Where PHP finds MySQL. On this machine (Herd, Valet, a server running MySQL
# locally) it is the loopback address. Inside the Docker stack the app container
# cannot see 127.0.0.1 — docker-compose pins DB_HOST to the `mysql` service name
# for every container, so this line only ever applies to host runs.
DB_HOST=mysql
DB_PORT=3306
# The three values below are the contract with docker-compose: the `mysql`
# service creates exactly this database and user on its first boot, so a fresh
# host needs nothing besides `make up`. Set DB_PASSWORD (and
# MYSQL_ROOT_PASSWORD, which only the container reads) before going public.
DB_DATABASE=rumaorganic
DB_USERNAME=rumaorganic
DB_PASSWORD=rumaorganic
# A managed MySQL (DigitalOcean, PlanetScale, RDS) usually insists on TLS. Point
# this at the certificate authority bundle and the connection verifies the server.
# MYSQL_ATTR_SSL_CA=
# The test suite runs on its own in-memory SQLite database (see phpunit.xml);
# nothing here affects it.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# "public" is the only disk with a web URL: uploaded images are stored under
# storage/app/public and reached through /storage. "local" would file them
# away where no visitor can ever load them.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Machine translation for the "Translate" button in the page editor.
# Leave GEMINI_API_KEY empty to switch the button off; nothing else breaks.
AI_TRANSLATION_PROVIDER=gemini
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.5-flash

VITE_APP_NAME="${APP_NAME}"

# Live chat over WebSockets. Run `php artisan reverb:install` to fill these in,
# then `php artisan reverb:start` — or `php artisan dev`, which runs the socket
# next to the server, queue, logs and Vite.
#
# The chat does not require this: with BROADCAST_CONNECTION=log or null the
# bubble still works, it just refreshes on a timer instead of on the socket.
# Setting it to "reverb" here (the last occurrence wins) turns the socket on.
BROADCAST_CONNECTION=reverb
# Laravel Reverb — the websocket server behind the live chat.
REVERB_APP_ID=883353
REVERB_APP_KEY=85c81e2d5d1d2be45c4d
REVERB_APP_SECRET=947ecf277eeccb9150a2
REVERB_HOST="32.236.186.96"
# The port browsers connect to. In the Docker stack nginx proxies /app/ to the
# reverb container, so this is the site's own port: 80 over HTTP, 443 behind
# TLS. A host-run dev server (Herd) has no such proxy, so use 8333 there and
# let the browser reach Reverb directly.
REVERB_PORT=80
# Where Reverb itself listens. In Docker the container command pins 8080; this
# matters for host runs, where it is the same port the browser uses.
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT="${REVERB_PORT}"
REVERB_SCHEME=http

# The same credentials for the browser. Without VITE_REVERB_APP_KEY the site
# skips the broadcast client entirely and the chat falls back to polling.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
