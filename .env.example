APP_NAME="Ruma Organic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Where PHP finds MySQL. On this machine (Herd, Valet, a server running MySQL
# locally) it is the loopback address. Inside the Docker stack the app container
# cannot see 127.0.0.1 — docker-compose pins DB_HOST to the `mysql` service name
# for every container, so this line only ever applies to host runs.
DB_HOST=127.0.0.1
DB_PORT=3306
# The three values below are the contract with docker-compose: the `mysql`
# service creates exactly this database and user on its first boot, so a fresh
# host needs nothing besides `make up`. Set DB_PASSWORD (and
# MYSQL_ROOT_PASSWORD, which only the container reads) before going public.
DB_DATABASE=ruma
DB_USERNAME=ruma
DB_PASSWORD=
# A managed MySQL (DigitalOcean, PlanetScale, RDS) usually insists on TLS. Point
# this at the certificate authority bundle and the connection verifies the server.
# MYSQL_ATTR_SSL_CA=
# The test suite runs on its own in-memory SQLite database (see phpunit.xml);
# nothing here affects it.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# "public" is the only disk with a web URL: uploaded images are stored under
# storage/app/public and reached through /storage. "local" would file them
# away where no visitor can ever load them.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Machine translation for the "Translate" button in the page editor.
# Leave GEMINI_API_KEY empty to switch the button off; nothing else breaks.
AI_TRANSLATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

VITE_APP_NAME="${APP_NAME}"

# Live chat over WebSockets. Run `php artisan reverb:install` to fill these in,
# then `php artisan reverb:start` — or `php artisan dev`, which runs the socket
# next to the server, queue, logs and Vite.
#
# The chat does not require this: with BROADCAST_CONNECTION=log or null the
# bubble still works, it just refreshes on a timer instead of on the socket.
# Setting it to "reverb" here (the last occurrence wins) turns the socket on.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
# Needs a free port. On a Laravel Herd machine 8080 already belongs to its
# nginx, and the Docker stack claims 8080 for the site, so 8333 is the
# usual choice. The browser keys below copy whatever is here, and
# `npm run build` bakes it into the broadcast client.
REVERB_PORT=8333
# Where Reverb itself listens — a separate setting from the address browsers
# are pointed at, which is why both need changing when the port moves.
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT="${REVERB_PORT}"
REVERB_SCHEME=http

# The same credentials for the browser. Leave VITE_REVERB_APP_KEY empty on a
# host that does not run Reverb: the site then skips the broadcast client.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
